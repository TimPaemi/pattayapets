{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pattayapets.com/schemas/business-contact-publication.v1.json",
  "title": "PattayaPets field-level contact publication ledger",
  "type": "object",
  "required": ["schemaVersion", "ledgerVersion", "reviewedAt", "policy", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "ledgerVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "reviewedAt": { "type": "string", "format": "date" },
    "policy": { "type": "object" },
    "records": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["disposition", "defaultPublicationState", "reviewedAt", "fields"],
      "properties": {
        "disposition": { "enum": ["PUBLISH", "HOLD", "REJECT"] },
        "defaultPublicationState": { "const": "withheld" },
        "reviewedAt": { "type": "string", "format": "date" },
        "fields": {
          "type": "object",
          "propertyNames": { "enum": ["phone", "tel", "whatsapp", "line", "email", "website"] },
          "additionalProperties": { "$ref": "#/$defs/fieldDecision" }
        }
      },
      "additionalProperties": false
    },
    "fieldDecision": {
      "type": "object",
      "required": ["classification", "publicationState", "publicationBasis", "optOutState", "source", "reviewedAt"],
      "properties": {
        "classification": { "enum": ["public-business", "unknown"] },
        "publicationState": { "enum": ["approved", "withheld"] },
        "publicationBasis": { "type": "string", "minLength": 1 },
        "optOutState": { "enum": ["none-recorded", "unknown"] },
        "source": { "type": "string", "format": "uri" },
        "reviewedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
