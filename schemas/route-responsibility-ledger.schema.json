{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pattayapets.com/schemas/route-responsibility-ledger.v1.json",
  "title": "PattayaPets route responsibility ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerVersion",
    "standardId",
    "projectClass",
    "reviewedAt",
    "defaultDisposition",
    "projectCreationEvidence",
    "routes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerVersion": { "type": "string", "pattern": "^2026-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "standardId": { "const": "TP-NETWORK-2026-08-04.1" },
    "projectClass": { "const": "OWNED PUBLICATION" },
    "reviewedAt": { "type": "string", "format": "date" },
    "defaultDisposition": { "const": "OMIT_PERSONAL_ATTRIBUTION" },
    "projectCreationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "evidenceRefs", "people", "note"],
      "properties": {
        "disposition": { "enum": ["APPROVED", "HOLD", "REJECTED"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "people": { "type": "array", "items": { "enum": ["tim", "paemi"] }, "uniqueItems": true },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "disposition", "reviewedAt", "evidenceRefs", "responsiblePeople", "note"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "disposition": { "enum": ["APPROVED", "HOLD", "REJECTED"] },
          "reviewedAt": { "type": "string", "format": "date" },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "responsiblePeople": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["person", "roles"],
              "properties": {
                "person": { "enum": ["tim", "paemi"] },
                "roles": {
                  "type": "array",
                  "items": { "enum": ["author", "creator", "editor", "reviewer"] },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
